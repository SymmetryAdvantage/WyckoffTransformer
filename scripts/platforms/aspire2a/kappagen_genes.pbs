#!/bin/bash
# ---------------------------------------------------------------------------
# kappagen gene campaign (scripts/kappagen_gene_campaign.py): 100k genes per
# ternary in docs/archive/final_kappagen_plus_si_sparse_or_disordered_ternary_systems.md
# and per binary subsystem, deduplicated and screened at predicted e_hull <= 0.15.
#
#     for i in 0 1 2 3 4 5; do qsub -q ai -v REPO=$PWD,STAGE=generate,SHARD=$i,NSHARDS=6 \
#         scripts/platforms/aspire2a/kappagen_genes.pbs; done
#     qsub -q ai -W depend=afterok:<ids> -l walltime=01:00:00 \
#         -v REPO=$PWD,STAGE=merge scripts/platforms/aspire2a/kappagen_genes.pbs
#
# A system whose systems/<system>.parquet exists is skipped, so a re-qsub resumes.
# ---------------------------------------------------------------------------
#PBS -N wyf_kappagen
#PBS -P 11001786
#PBS -l select=1:ngpus=1:ncpus=16:mem=110gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /scratch/users/nus/kna/WyFormer/logs/

set -u
REPO=${REPO:-/home/project/11001786/WyFormer/WyckoffTransformer}
OUT=${OUT:-/scratch/users/nus/kna/WyFormer/runs/kappagen_genes}
STAGE=${STAGE:-generate}
SHARD=${SHARD:-0}
NSHARDS=${NSHARDS:-1}

cd "$REPO"
type module >/dev/null 2>&1 || source /etc/profile.d/modules.sh
module load singularity 2>/dev/null || true
module load git/2.39.2 2>/dev/null || true
echo "$(date) commit $(git rev-parse HEAD 2>/dev/null) stage $STAGE shard $SHARD/$NSHARDS out $OUT"
R="bash scripts/platforms/aspire2a/run_in_singularity.sh"
if [ "$STAGE" = merge ]; then
    $R python scripts/kappagen_gene_campaign.py merge --out "$OUT" --wandb
else
    $R python scripts/kappagen_gene_campaign.py generate --out "$OUT" \
        --shard "$SHARD" --n-shards "$NSHARDS" --device cuda
fi
echo "$(date) exit $?"
