#!/bin/bash
# ---------------------------------------------------------------------------
# Full training of yamls/models/lemat_bulk_ehull/ehull_adamw_wsd_5x.yaml on one
# GPU in the AI partition (aiq1, 24 h ceiling), with live W&B logging.
#
# The config is 40000 epochs / ~3.2M optimiser steps -- far more than 24 h -- so
# this script CHAINS itself. Each link:
#   * pins one W&B run id (persisted in runs/.ehull_5x.runid),
#   * resumes from runs/<run-id>/last_checkpoint.pt (optimiser + scheduler +
#     loader + RNG state),
#   * runs train.py under `timeout` so it stops ~30 min before the wall, hands
#     control back cleanly, and re-qsubs itself,
#   * stops when train.py exits 0 (all epochs + the config's evaluation done) or
#     the attempt cap is hit.
# One `qsub scripts/train_ehull_5x.pbs` launches the whole run.
#
# Submit:
#     cd /scratch/users/nus/kna/WyckoffTransformer
#     mkdir -p logs
#     qsub scripts/train_ehull_5x.pbs
#
# Start a fresh run (new W&B id) after a completed / abandoned one:
#     rm -f runs/.ehull_5x.runid
#
# W&B: live to symmetry-advantage/WyckoffTransformer (entity/project pinned in
# scripts/train.py). Auth is ~/.netrc, visible in the container via the automatic
# $HOME bind. For offline + `wandb sync` instead, uncomment WANDB_MODE below.
#
# Queue: aiq1 is `from_route_only` -- you cannot `qsub -q aiq1` directly. Jobs
# go to the `ai` routing queue, which dispatches by (ngpus, walltime):
#   aiq1: ngpus=1          walltime in (02:00:01, 24:00:00]   <- this job
#   aiq2: ngpus in [2,3]   aiq3: ngpus=4   aiq4: ngpus>=5      (same walltime band)
#   aidev: walltime <= 2h  ailong: walltime > 24h
# So `-q ai` + select=1:ngpus=1 + a walltime in that band is what lands in aiq1.
# (g1, on the separate pbs101 server, is an equivalent <=24 h fallback --
# `-q g1@pbs101` from a login node; not reachable from an AI-partition session.)
# ---------------------------------------------------------------------------
#PBS -N wyf_ehull5x
#PBS -q ai
#PBS -P 11001786
#PBS -l select=1:ngpus=1:ncpus=16:mem=64gb
#PBS -l walltime=23:59:59
#PBS -j oe
#PBS -o /scratch/users/nus/kna/WyckoffTransformer/logs/

set -u

# --- fixed paths ---------------------------------------------------------------
REPO=/scratch/users/nus/kna/WyckoffTransformer
# The stores may live outside the checkout: resolved from
# ~/.config/wyformer/paths.env (docs/data_store.md), the checkout being the
# fallback only when there is no config file. Exported so the container's Python
# uses exactly these, whatever it would resolve on its own.
# shellcheck source=scripts/wyformer_paths.sh
. "$REPO/scripts/wyformer_paths.sh"
# Explicit exits: `set -e` is not on yet at this point in the script.
DATA_DIR=$(wyformer_path WYFORMER_DATA "$REPO/data") || exit 1
CACHE_DIR=$(wyformer_path WYFORMER_CACHE "$REPO/cache") || exit 1
RUNS_DIR=$(wyformer_path WYFORMER_RUNS "$REPO/runs") || exit 1
WANDB_ROOT=$(wyformer_path WANDB_DIR "$REPO") || exit 1
export WYFORMER_DATA="$DATA_DIR" WYFORMER_CACHE="$CACHE_DIR" WYFORMER_RUNS="$RUNS_DIR" \
       WANDB_DIR="$WANDB_ROOT"

SIF=/home/users/nus/kna/pytorch_2.14.0-cuda12.6-cudnn9-devel.sif
CONFIG=yamls/models/lemat_bulk_ehull/ehull_adamw_wsd_5x.yaml
DATASET=lemat_bulk_ehull
PBS_SCRIPT="$REPO/scripts/train_ehull_5x.pbs"
QSUB=/opt/pbs/bin/qsub

MAX_ATTEMPTS=8               # hard stop on the resubmission chain
ATTEMPT=${ATTEMPT:-1}        # bumped via `qsub -v` on each link
# Stop training this far before the 23:59:59 wall so the last checkpoint flushes,
# W&B uploads, and the next job is queued while we still own the node.
TRAIN_TIMEOUT=${TRAIN_TIMEOUT:-84600}   # 23 h 30 m

cd "$REPO"
mkdir -p logs runs

# --- persistent W&B run id ---------------------------------------------------
RUNID_FILE="$RUNS_DIR/.ehull_5x.runid"
if [ -n "${RUN_ID:-}" ]; then
    :                                       # passed down the chain
elif [ -f "$RUNID_FILE" ]; then
    RUN_ID=$(cat "$RUNID_FILE")
else
    RUN_ID="ehull5x-$(date +%Y%m%d-%H%M%S)"
    echo "$RUN_ID" > "$RUNID_FILE"
fi
RUN_DIR="$RUNS_DIR/$RUN_ID"

echo "=========================================================="
echo "attempt   : $ATTEMPT / $MAX_ATTEMPTS"
echo "wandb id  : $RUN_ID"
echo "run dir   : $RUN_DIR"
echo "pbs job   : ${PBS_JOBID:-<interactive>}   node: $(hostname)"
echo "start     : $(date -Is)"
echo "=========================================================="
nvidia-smi || true

if [ -f "$RUN_DIR/COMPLETED" ]; then
    echo "run already marked COMPLETED -- nothing to do"
    exit 0
fi

# A run dir with no local checkpoint is NOT necessarily a crash before the first
# save. `runs/` may be purge-policy scratch (docs/data_store.md), so the trainer
# mirrors last_checkpoint.pt to W&B; ask before giving up, because a purged run has
# trained epochs that exist nowhere else. train.py refuses to mkdir over an existing
# dir, so a genuinely spent dir is moved aside -- never deleted, since it can hold
# the only local best_model_params.pt.
RESUME_ARGS=()
if [ -f "$RUN_DIR/last_checkpoint.pt" ]; then
    RESUME_ARGS=(--resume "$RUN_ID")
    echo "resuming from $RUN_DIR/last_checkpoint.pt"
elif [ -d "$RUN_DIR" ]; then
    PROBE_RC=0
    PROBE_OUT=$(bash "$REPO/scripts/run_in_singularity.sh" \
        python -m wyckoff_transformer.cli.resume_probe "$RUN_ID" --runs-path "$RUNS_DIR" 2>&1) \
        || PROBE_RC=$?
    if [ "$PROBE_RC" -eq 0 ]; then
        RESUME_ARGS=(--resume "$RUN_ID")
        echo "no local checkpoint -> train.py will recover it from W&B: $PROBE_OUT"
    elif [ "$PROBE_RC" -eq 1 ]; then
        SPENT_DIR="$RUN_DIR.spent-$(date +%Y%m%d-%H%M%S)"
        echo "run dir has no resume state anywhere -> moving it to $SPENT_DIR" >&2
        mv "$RUN_DIR" "$SPENT_DIR"
    else
        echo "error: cannot tell whether $RUN_ID has resume state ($PROBE_OUT)." >&2
        echo "error: refusing to start over -- its epochs may exist only in W&B." >&2
        exit 1
    fi
fi

# --- environment for the container -----------------------------------------
# Put singularity on PATH without relying on the module system in a batch shell.
if ! command -v singularity >/dev/null 2>&1; then
    export PATH="/app/apps/singularity/sup/squashfuse/0.6.1/bin:/app/apps/singularity/3.10.0/bin:$PATH"
fi
command -v singularity >/dev/null 2>&1 || { source /etc/profile.d/modules.sh 2>/dev/null && module load singularity; }
singularity --version

export SINGULARITYENV_WANDB_RUN_ID="$RUN_ID"
export SINGULARITYENV_WANDB__SERVICE_WAIT=300
export SINGULARITYENV_HF_HUB_OFFLINE=1
export SINGULARITYENV_TOKENIZERS_PARALLELISM=false
export SINGULARITYENV_OMP_NUM_THREADS=16
# export SINGULARITYENV_WANDB_MODE=offline   # offline + `wandb sync <run-dir>` later

# The mark a crash below is judged against: the mtime of the checkpoint this attempt
# starts from, or 0 when there is nothing to resume.
CKPT_MTIME_BEFORE=$(stat -c %Y "$RUN_DIR/last_checkpoint.pt" 2>/dev/null || echo 0)

# --- train -----------------------------------------------------------------
set +e
timeout --signal=TERM --kill-after=180 "$TRAIN_TIMEOUT" \
    bash "$REPO/scripts/run_in_singularity.sh" \
        python scripts/train.py "$CONFIG" "$DATASET" cuda \
            --run-path "$RUNS_DIR" ${RESUME_ARGS[@]+"${RESUME_ARGS[@]}"}
rc=$?
set -e

echo "----------------------------------------------------------"
echo "train.py exit code: $rc   ($(date -Is))"

# --- completion / chaining -------------------------------------------------
if [ "$rc" -eq 0 ]; then
    touch "$RUN_DIR/COMPLETED"
    echo "TRAINING COMPLETE for $RUN_ID"
    exit 0
fi

# rc 124 = our timeout fired (expected once per ~24 h): the link had its whole slot,
# so chain it. Any other non-zero is a crash, and what makes chaining a crash safe is
# that the attempt got somewhere first -- the existence of a checkpoint does not say
# that, because a resume that dies on its first line is still holding the one the
# previous link wrote. Requiring a NEW checkpoint is what keeps a deterministic
# failure from spending the whole attempt budget in a few minutes, which is how both
# ehull chains ended: eight links, each dying in the same place on the resume.
if [ "$rc" -ne 124 ]; then
    ckpt_mtime_after=$(stat -c %Y "$RUN_DIR/last_checkpoint.pt" 2>/dev/null || echo 0)
    if [ "$ckpt_mtime_after" -le "$CKPT_MTIME_BEFORE" ]; then
        echo "crashed without writing a checkpoint -> hard stop (see log above)" >&2
        echo "once the cause is fixed, 'qsub $PBS_SCRIPT' resumes $RUN_ID with a fresh budget" >&2
        exit "$rc"
    fi
    echo "crashed, but this attempt wrote a checkpoint -> continuing from it"
fi

if [ "$ATTEMPT" -ge "$MAX_ATTEMPTS" ]; then
    echo "attempt cap ($MAX_ATTEMPTS) reached -> stopping; 'qsub $PBS_SCRIPT' to continue" >&2
    exit "$rc"
fi

echo "resubmitting to continue from checkpoint (attempt $((ATTEMPT + 1)))"
"$QSUB" -v RUN_ID="$RUN_ID",ATTEMPT="$((ATTEMPT + 1))" "$PBS_SCRIPT"
